# Environment variables of the website (set them in Vercel → Settings → Environment Variables).
# Never commit real values.

# Public address of the site, e.g. https://verify.example.com
APP_URL=
# Shown in the header and page titles
SITE_NAME=Zack Verify
# Optional: contact shown in the privacy notice (an email address, "the #support channel", ...)
PRIVACY_CONTACT=

# Discord OAuth (Developer Portal → OAuth2). Add the redirect:  <APP_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# Address of the bot API (through your tunnel / reverse proxy) and the signing key.
# API_SECRET must be IDENTICAL to the bot's API_SECRET (at least 32 characters).
BOT_API_URL=
API_SECRET=

# Cloudflare Turnstile site key (public; the secret key lives on the bot)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Signs the OAuth "state" cookie, at least 32 characters
SESSION_SECRET=

# --- Local testing only (NEVER set in production) ---
# E2E_MOCK_DISCORD=
# DISCORD_API_BASE=
# DISCORD_AUTHORIZE_URL=
