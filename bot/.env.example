# Copy to ".env" and fill in. ".env" must never be committed.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Discord application (Developer Portal) ---
TOKEN=
CLIENT_ID=
GUILD_ID=

# --- Roles (right-click → Copy Role ID; the bot's own role must sit ABOVE both) ---
VERIFIED_ROLE_ID=
UNVERIFIED_ROLE_ID=
# Comma-separated roles that may use the staff buttons/commands. Members with "Manage Server" always can.
STAFF_ROLE_IDS=

# --- Channels ---
# Every attempt is logged here (staff only!)
VERIFY_LOG_CHANNEL_ID=
# Attempts that need manual review (Approve / Reject buttons). Defaults to the log channel.
VERIFY_REVIEW_CHANNEL_ID=
# Optional: joins and leaves are logged here
JOIN_LOG_CHANNEL_ID=

# --- Look ---
BRAND_NAME=Zack Verify
EMBED_COLOR=23A55A

# --- Web verification ---
# Public address of the website (used by /verify-panel)
VERIFY_WEB_URL=
# The API listens here. Keep it on loopback and expose it through a tunnel / reverse proxy.
API_HOST=127.0.0.1
API_PORT=8787
# All three must be at least 32 characters. API_SECRET must be IDENTICAL on the website.
API_SECRET=
HASH_PEPPER=
DEVICE_SECRET=
# Cloudflare Turnstile secret key (stays on the bot, never on the website)
TURNSTILE_SECRET=
# Hostnames Turnstile must report, comma-separated (your website's domain)
TURNSTILE_HOSTNAMES=
# Local testing ONLY: uses Cloudflare's always-pass test secret and skips hostname/session matching.
# The bot refuses to start with it when NODE_ENV=production.
# TURNSTILE_TEST_KEYS=1

# --- Risk engine ---
# Optional proxycheck.io key (works without one at a very low daily quota)
PROXYCHECK_KEY=
# What to do when the IP lookup fails: open (small score), review (manual review, default), closed (block)
IP_CHECK_FAIL_MODE=review
MIN_ACCOUNT_AGE_DAYS=7
RISK_REVIEW_THRESHOLD=40
RISK_BLOCK_THRESHOLD=80
# Submitted attempts allowed per Discord account
RETRY_PER_HOUR=3
RETRY_PER_DAY=6
# Optional soft rule "COUNTRY:language": a visitor from that country whose browser has no matching
# language gets a small score. Example: TR:tr  (leave empty to disable)
LOCALE_HINT=

# --- Raid mode ---
# If RAID_JOIN_COUNT members join within RAID_WINDOW_SEC seconds, everyone goes to manual review
# until RAID_CALM_MIN minutes pass without a trigger.
RAID_WINDOW_SEC=60
RAID_JOIN_COUNT=10
RAID_CALM_MIN=15

# --- Storage ---
# Defaults to bot/data/verify.db
# DB_PATH=
